# Every text file is LF in the repository and in every checkout, Windows included (core.autocrlf does not apply).
* text=auto eol=lf
# The original data stays byte-identical: many of its text files are committed with CRLF. Never converted.
original-data/** -text
# The large binary tables of the original data are in LFS.
*.shn filter=lfs diff=lfs merge=lfs -text
*.shbd filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.BMP filter=lfs diff=lfs merge=lfs -text
